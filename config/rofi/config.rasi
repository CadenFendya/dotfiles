
configuration {
    modes: "drun";
    sorting-method: "normal";
    show-icons: true;
    matching: "regex";
    drun-match-fields: "name";
    display-run: "menu:";
    display-drun: "Launch:";
}

/* Matches waybar: black background, white text, no borders */
* {
    font: "Iosevka Nerd Font 11";
    background-color: transparent;
    text-color: #ffffff;

    /* Override rofi's built-in solarized palette so no tan/teal leaks through */
    foreground: #ffffff;
    background: transparent;
    lightbg: transparent;
    lightfg: #ffffff;
    normal-foreground: #ffffff;
    normal-background: transparent;
    alternate-normal-foreground: #ffffff;
    alternate-normal-background: transparent;
    selected-normal-foreground: #ffffff;
    selected-normal-background: rgba(255, 255, 255, 0.12);
    border-color: transparent;
    separatorcolor: transparent;

    margin: 0px;
    padding: 0px;
    spacing: 0px;
    border: 0px;
}

/* ===== Window ===== */
window {
    location: center;
    width: 500;
    y-offset: -20;

    border-radius: 0px;
    background-color: rgba(0, 0, 0, 0.45);
}

/* ===== Main container ===== */
mainbox {
    padding: 0px;
    background-color: transparent;
}

/* ===== Input bar ===== */
inputbar {
    background-color: rgba(255, 255, 255, 0.06);
    padding: 8px 16px;
    spacing: 8px;
}

prompt {
    text-color: #ffffff;
}

entry {
    text-color: #ffffff;
    placeholder: "search";
    placeholder-color: #777777;
}

/* ===== List ===== */
listview {
    background-color: transparent;
    margin: 10px 0 0;

    columns: 1;
    lines: 6;
    fixed-height: false;
}

scrollbar {
    handle-color: rgba(255, 255, 255, 0.35);
}

/* ===== Elements ===== */
element {
    padding: 10px 6px;
    spacing: 6px;
    background-color: transparent;
}

element normal normal,
element normal urgent,
element normal active,
element alternate normal,
element alternate urgent,
element alternate active {
    background-color: transparent;
    text-color: #ffffff;
}

element selected normal,
element selected urgent,
element selected active {
    background-color: rgba(255, 255, 255, 0.12);
    text-color: #ffffff;
}

/* ===== Icons & text ===== */
element-icon {
    size: 1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    background-color: transparent;
}

/* ===== Message box ===== */
message {
    margin: 12px 0 0;
    background-color: #111111;
}

textbox {
    padding: 8px 24px;
    background-color: #111111;
}
