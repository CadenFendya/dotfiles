{
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 1,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,

  "modules-left": ["hyprland/workspaces","image#greninja","custom/greninja"],
  "modules-right": [
    "group/tray",
    "bluetooth",
    "wireplumber",
    "battery",
    "mpris",
    "clock",
    "custom/power"
  ],
  "custom/tab": {
  "format": "[Z]",
  "on-click": "rofi -show drun",
},
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
  },

  "mpris": {
    "format": "  {artist} - {title}",
    "format-paused": "󰐊  {artist} - {title}",
    "max-length": 37,
    "tooltip": true,
    "player": "spotify"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 6
  },
// Animated white Greninja: greninja.sh swaps the frame, the image module redraws it.
// (The old cpucat module and catloop.sh are still around if you want the cat back.)
"image#greninja": {
    "path": "/run/user/1000/waybar-greninja.png",
    "size": 28,
    "interval": 0.05,
    "tooltip": false
},
"custom/greninja": {
    "exec": "~/.config/waybar/scripts/greninja.sh"
},
  // The real tray is kept running (it hosts the tray icons) but tucked into a
  // drawer that never opens; the chevron shows the icons in a flyout instead.
  "group/tray": {
    "orientation": "horizontal",
    "drawer": {
      "click-to-reveal": true
    },
    "modules": ["custom/tray-toggle", "tray"]
  },

  "custom/tray-toggle": {
    "format": "<span size='large'>󰅃</span>",
    "tooltip-format": "Show hidden icons",
    "on-click": "~/.config/waybar/scripts/flyout.py tray"
  },

  "wireplumber": {
    "scroll-step": 5,
    "format": "<span size='large'>{icon}</span>",
    "format-muted": "<span size='large'>󰝟</span>",
    "tooltip-format": "{volume}% · {node_name}",
    "on-click": "~/.config/waybar/scripts/flyout.py volume",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
      "headphones": "󰋋",
      "headset": "󰋎"
    }
  },


  "bluetooth": {
    "format": "<span size='large'>󰂯</span> {status}",
    "format-on": "<span size='large'>󰂯</span>",
    "format-off": "<span size='large'>󰂲</span>",
    "format-disabled": "<span size='large'>󰂲</span>",
    "format-connected": "<span size='large'>󰂱</span> {device_alias}",
    "format-connected-battery": "<span size='large'>󰂱</span> {device_alias} {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "~/.config/waybar/scripts/flyout.py bluetooth",
    "on-click-right": "bluetoothctl power toggle"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󱟦 {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-icons": [
      "󰂎", "󰁺", "󰁻", "󰁼", "󰁽",
      "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
    ]
  },

  "clock": {
    "format": "{:%m-%d-%Y %H:%M}"
  },

  "custom/power": {
    "format": "<span size='large'>󰐥</span>",
    "tooltip-format": "Power",
    "on-click": "~/.config/waybar/scripts/flyout.py power"
  }
}
